{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Local Software Factory: MCP tools for the Context owner and the sf CLI",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sf": "bin/sf"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-types.json",
    "build": "node scripts/build.mjs",
    "start": "node dist/src/cli.js serve",
    "check-code": "node scripts/check-code.mjs",
    "test": "npm run check-code && npm run build && node scripts/run-tests.mjs unit",
    "browsers": "playwright install chromium",
    "test:browser": "npm run build && node scripts/check-browser.mjs && node scripts/run-tests.mjs browser"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  }
}
