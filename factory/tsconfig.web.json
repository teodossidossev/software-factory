{
  "compilerOptions": {
    "target": "es2023",
    "module": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "rootDir": "web",
    "outDir": "dist/web"
  },
  "include": ["web"]
}
